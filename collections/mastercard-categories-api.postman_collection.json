          "name": "Provide Supported MCCs",
          "request": {
            "name": "Provide Supported MCCs",
            "description": {
              "content": "Provides a list of merchant category codes supported by the application. While sending transaction data in the Transaction object, 'mcc' should be from one of the supported merchant categories. It is recommended to cache this list and use it for checking before sending transactions for footprint calculation. Generally this list doesn't change that often, but it is recommended to refresh this data every 24-hours.",
              "type": "text/plain"
            },

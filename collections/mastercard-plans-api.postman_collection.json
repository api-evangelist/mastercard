          "name": "Retrieves Buy Now, Pay Later installment plan.",
          "request": {
            "name": "Retrieves Buy Now, Pay Later installment plan.",
            "description": {
              "content": "This operation returns a BNPL installment plan based on the selected plan ID provided in the request. The API response contains encrypted values of the consumer's email and phone, and the issuer needs to decrypt the response using the Mastercard client encryption key.",

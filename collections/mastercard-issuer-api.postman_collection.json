          "name": "Mastercard Delete One or More Users.",
          "request": {
            "name": "Mastercard Delete One or More Users.",
            "description": {
              "content": "<ul><li>Allows a registered Service Provider to delete one or more users.</li> <li>Payment cards associated with the user will also be deleted.</li> <li>On a successful response from the Server, the Service Provider should remove all the requested users and associated payment cards from the system.</li></ul>",
              "type": "text/plain"
            },

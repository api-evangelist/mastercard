{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mastercard Bill Payment Validator Account Opening Agreements API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Agreements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mastercard Agreement Creation.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/agreements",
            "headers": [
              {
                "name": "X-Request-ID",
                "value": ""
              },
              {
                "name": "X-Product-ID",
                "value": ""
              },
              {
                "name": "X-Participant-ID",
                "value": ""
              },
              {
                "name": "X-JWS-Signature",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enables the CSP to present request for agreement creation."
        },
        {
          "info": {
            "name": "Mastercard Retrieve Agreement Details",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/agreement-retrievals",
            "headers": [
              {
                "name": "X-Request-ID",
                "value": ""
              },
              {
                "name": "X-Product-ID",
                "value": ""
              },
              {
                "name": "X-Participant-ID",
                "value": ""
              },
              {
                "name": "X-JWS-Signature",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enables DSP to retrieve agreement details, either agreementId or agreementReferenceNumber must be provided to retrieve agreement details."
        },
        {
          "info": {
            "name": "Mastercard Retrieve Agreement List",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/agreement-searches",
            "headers": [
              {
                "name": "X-Request-ID",
                "value": ""
              },
              {
                "name": "X-Product-ID",
                "value": ""
              },
              {
                "name": "X-Participant-ID",
                "value": ""
              },
              {
                "name": "X-JWS-Signature",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enables DSP to retrieve list of active agreements."
        },
        {
          "info": {
            "name": "Mastercard Update Agreement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/agreements/:agreement_id/updates",
            "headers": [
              {
                "name": "X-Request-ID",
                "value": ""
              },
              {
                "name": "X-Product-ID",
                "value": ""
              },
              {
                "name": "X-Participant-ID",
                "value": ""
              },
              {
                "name": "X-JWS-Signature",
                "value": ""
              },
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agreement_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier assigned by Mastercard, to the agreement, to be used in Payment Requests for routing them to the destined participant."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enables DSP to update agreement status to Approved or Rejected or Deleted or update account nickname. Nickname must be supplied when agreement status is Approved.\n  - Update Status - status can be updated from in progress to approved or rejected, when it is approved nickname has to be provided.\n  - Update Nickname - agreementId and nickname has be to supplied.\n  - Delete Agreement - status can be updated from approved to deleted."
        }
      ]
    }
  ],
  "bundled": true
}
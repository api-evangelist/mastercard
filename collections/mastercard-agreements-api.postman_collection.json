        {
          "id": "790842b7-3337-4925-bf70-6d3bcd975e58",
          "name": "Mastercard Update Agreement",
          "request": {
            "name": "Mastercard Update Agreement",
            "description": {
              "content": "Enables DSP to update agreement status to Approved or Rejected or Deleted or update account nickname. Nickname must be supplied when agreement status is Approved.\n  - Update Status - status can be updated from in progress to approved or rejected, when it is approved nickname has to be provided.\n  - Update Nickname - agreementId and nickname has be to supplied.\n  - Delete Agreement - status can be updated from approved to deleted.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agreements",
                ":agreement_id",
                "updates"
              ],
              "host": [

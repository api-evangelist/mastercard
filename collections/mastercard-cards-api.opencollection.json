              },
              {
                "name": "x-correlation-id",
                "value": ""
              },
              {
                "name": "ProgramId",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "donor_id",
                "value": "",
                "type": "path",
                "description": "donor_id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Donor can add his/her card onto platform by calling this API, so that next time he/she wants to donate, he/she don't have to provide card details.A card will be added once. Second time, the initial card Id will be returned.Entire request body should be encrypted."
        },

    "_postman_id": "86901819-6c0b-4c7e-89a3-934b66cd4999",
    "name": "Mastercard Bill Payment Validator Account Opening Retrievals API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "This service is provided on behalf of the Mastercard Remote Payment and Presentment (RPPS) Bill Payment Processing Network, which supports consumer to business \"push\" bill payments (i.e. those which are not funded by debit/credit card transactions) in the U.S.\n\nContact Support:\n Name: Bill Pay Development Support\n Email: Bill_Pay_Development_Support@mastercard.com",
      "type": "text/plain"
    }

        {
          "id": "53566364-9052-4d5c-941d-aa89904b42e7",
          "name": "Mastercard Update Dpa Data",
          "request": {
            "name": "Mastercard Update Dpa Data",
            "description": {
              "content": "This API is used to update an existing DPA (as referred to by srciDpaId) under a customer's organizationId.\n\n__Note__:\n\nA limited number of DPA fields can be changed using the __UPDATE__ action. These are `supportedCardBrands`, `supportedCheckoutTypes`, `dpaPresentationName`, `originDomains`,  `debitTokenRequested`, `merchantCategoryCodes`, `defaultAcquirerBin`, `defaultAcquirerMerchantId`, `defaultMerchantCategoryCode`, `acquirerIca`, `acquirerBin` and `acquirerMerchantId`.\n\nAll DPA data from the original request (including non-updatable fields, such as `dpaUri` and `dpaAddress` if previously passed) will also need to be provided unchanged in the __PUT__ request for the update operation to process successfully. Any alterations contained in the request made outside of these updatable fields will cause the request to fail.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "org",
                ":organization_id",
                "dpas",
                ":srci_dpa_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "477c6070-a7a3-4a0d-ad43-245d0d14d15d",
              "name": "Returns 200 no content",
              "originalRequest": {
                "url": {
                  "path": [
                    "org",
                    ":organization_id",
                    "dpas",
                    ":srci_dpa_id"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "method": "PUT",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"dpa\": {\n    \"supportedCardBrands\": [\n      \"MASTERCARD\"\n    ],\n    \"dpaData\": {\n      \"dpaName\": \"myShop\",\n      \"dpaPresentationName\": \"myShop_updated\",\n      \"dpaUri\": \"https://example.com/ecom-online-ltd/basket.html\"\n    },\n    \"debitTokenRequested\": true,\n    \"merchantCountryCode\": \"US\",\n    \"supportedCheckoutTypes\": [\n      \"CLICK_TO_PAY\"\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },

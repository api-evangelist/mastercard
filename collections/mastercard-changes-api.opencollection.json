              {
                "name": "sub_merchant_id",
                "value": "cc2cac41-d127-4c06-9646-c0f2ad76c444",
                "type": "path",
                "description": "Sub-merchant member ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"

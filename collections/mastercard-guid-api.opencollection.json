        {
          "info": {
            "name": "Mastercard Activate/deactivate a Sub-merchant.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/sub-merchants/:guid/states",
            "headers": [
              {
                "name": "User-Id",
